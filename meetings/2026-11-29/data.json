{"sections":[{"title":"1. 오프닝 · 오늘의 주제는 하루 일과 (Mi rutina diaria)","lines":[{"s":"S","t":0.2,"es":"Bienvenidos a Easy Spanish Podcast. Hola, soy Sofía.","ko":"Easy Spanish Podcast에 오신 걸 환영해요. 안녕하세요, 저는 소피아예요."},{"s":"M","t":8.0,"es":"Hola, soy Mateo.","ko":"안녕하세요, 저는 마테오예요."},{"s":"S","t":11.0,"es":"Mateo, ¿estás listo para aprender español hoy?","ko":"마테오, 오늘 스페인어 배울 준비 됐어요?"},{"s":"M","t":16.0,"es":"Sí, estoy listo.","ko":"네, 준비됐어요."},{"s":"S","t":19.2,"es":"Perfecto. Hoy vamos a hablar de un tema muy interesante.","ko":"좋아요. 오늘은 아주 흥미로운 주제로 이야기할 거예요."},{"s":"M","t":25.0,"es":"¿Qué tema?","ko":"무슨 주제요?"},{"s":"S","t":26.8,"es":"Tu día. Vamos a hablar de mi rutina diaria.","ko":"당신의 하루요. 제 하루 일과에 대해 이야기할 거예요."},{"s":"M","t":33.3,"es":"Mi rutina. ¡Qué bien!","ko":"하루 일과. 좋네요!"},{"s":"S","t":37.6,"es":"Sí, desde la mañana hasta la noche. ¿Entendido?","ko":"네, 아침부터 밤까지요. 알겠죠?"}]},{"title":"2. 아침 ① 일어나기 (Me despierto · Me levanto)","lines":[{"s":"S","t":45.4,"es":"Empezamos con la mañana. ¿De acuerdo? Por la mañana me despierto.","ko":"아침부터 시작해요. 좋죠? 아침에 저는 잠에서 깨요."},{"s":"M","t":56.3,"es":"Me despierto.","ko":"잠에서 깨요."},{"s":"S","t":60.1,"es":"Muy bien. Después me levanto.","ko":"아주 좋아요. 그다음에 일어나요."},{"s":"M","t":65.7,"es":"Me levanto.","ko":"일어나요."},{"s":"S","t":68.8,"es":"Excelente. «Me despierto» es abrir los ojos.","ko":"훌륭해요. me despierto는 눈을 뜨는 거예요."},{"s":"M","t":76.6,"es":"Ah, sí.","ko":"아, 네."},{"s":"S","t":78.8,"es":"«Me levanto» es salir de la cama.","ko":"me levanto는 침대에서 나오는 거예요."},{"s":"M","t":83.6,"es":"Entiendo.","ko":"알겠어요."},{"s":"S","t":85.4,"es":"Yo me levanto a las siete.","ko":"저는 7시에 일어나요."},{"s":"M","t":90.8,"es":"A las siete.","ko":"7시에."},{"s":"S","t":93.3,"es":"Y tú, Mateo, ¿a qué hora te levantas?","ko":"마테오는 몇 시에 일어나요?"},{"s":"M","t":99.5,"es":"Yo me levanto a las ocho.","ko":"저는 8시에 일어나요."},{"s":"S","t":104.6,"es":"A las ocho. Muy bien.","ko":"8시. 아주 좋아요."},{"s":"M","t":108.5,"es":"Sí.","ko":"네."},{"s":"S","t":110.0,"es":"Entonces, tú te levantas a las ocho.","ko":"그러니까 당신은 8시에 일어나는군요."},{"s":"M","t":117.2,"es":"Correcto. Me levanto a las ocho.","ko":"맞아요. 저는 8시에 일어나요."}]},{"title":"3. 아침 ② 씻고 입고 먹기 (Me ducho · Me visto · Desayuno)","lines":[{"s":"S","t":121.2,"es":"Continuamos con la mañana.","ko":"아침을 계속해 봐요."},{"s":"M","t":124.5,"es":"Vale.","ko":"좋아요."},{"s":"S","t":125.9,"es":"Después de levantarme, me ducho.","ko":"일어난 다음에 샤워를 해요."},{"s":"M","t":130.2,"es":"Me ducho.","ko":"샤워해요."},{"s":"S","t":132.7,"es":"Muy bien. Después me lavo los dientes.","ko":"아주 좋아요. 그다음에 이를 닦아요."},{"s":"M","t":139.3,"es":"Me lavo los dientes.","ko":"이를 닦아요."},{"s":"S","t":143.4,"es":"Y luego me visto.","ko":"그리고 옷을 입어요."},{"s":"M","t":147.8,"es":"Me visto.","ko":"옷을 입어요."},{"s":"S","t":150.3,"es":"Y finalmente desayuno.","ko":"그리고 마지막으로 아침을 먹어요."},{"s":"M","t":154.7,"es":"Desayuno.","ko":"아침을 먹어요."},{"s":"S","t":156.8,"es":"Entonces, mi rutina de la mañana es: me levanto, me ducho, me lavo los dientes, me visto, desayuno.","ko":"그러니까 제 아침 일과는: 일어나요, 샤워해요, 이를 닦아요, 옷을 입어요, 아침을 먹어요."},{"s":"M","t":172.6,"es":"Sí.","ko":"네."},{"s":"S","t":173.8,"es":"¿Qué haces tú por la mañana, Mateo?","ko":"마테오는 아침에 뭐 해요?"},{"s":"M","t":178.2,"es":"Yo me levanto.","ko":"저는 일어나요."},{"s":"S","t":182.2,"es":"Sí.","ko":"네."},{"s":"M","t":183.6,"es":"Después me ducho.","ko":"그다음에 샤워해요."},{"s":"S","t":188.2,"es":"Perfecto. ¿Algo más?","ko":"완벽해요. 또 있어요?"},{"s":"M","t":191.2,"es":"Me lavo los dientes.","ko":"이를 닦아요."},{"s":"S","t":195.6,"es":"Muy bien. Lo haces genial.","ko":"아주 좋아요. 정말 잘하고 있어요."}]},{"title":"4. 아침 식사 (¿Qué desayunas?)","lines":[{"s":"S","t":199.4,"es":"Ahora vamos a hablar del desayuno. ¿Tú desayunas, Mateo?","ko":"이제 아침 식사 이야기를 해요. 마테오는 아침 먹어요?"},{"s":"M","t":209.7,"es":"Sí, yo desayuno.","ko":"네, 아침 먹어요."},{"s":"S","t":213.2,"es":"¡Qué bien! ¿Qué desayunas?","ko":"좋네요! 아침으로 뭘 먹어요?"},{"s":"M","t":217.3,"es":"Yo desayuno café. Café, me gusta. Y… café y pan.","ko":"아침으로 커피를 마셔요. 커피를 좋아해요. 그리고… 커피와 빵이요."},{"s":"S","t":231.5,"es":"Un desayuno típico.","ko":"전형적인 아침 식사네요."},{"s":"M","t":234.8,"es":"Sí.","ko":"네."},{"s":"S","t":236.1,"es":"¿A qué hora desayunas?","ko":"몇 시에 아침을 먹어요?"},{"s":"M","t":240.0,"es":"Yo desayuno a las ocho y media.","ko":"저는 8시 반에 아침을 먹어요."},{"s":"S","t":245.3,"es":"A las ocho y media. ¿Entendido?","ko":"8시 반. 알겠죠?"},{"s":"M","t":250.4,"es":"Sí. Desayuno a las ocho y media.","ko":"네. 8시 반에 아침을 먹어요."}]},{"title":"5. 일하러 가요 (Voy al trabajo)","lines":[{"s":"S","t":256.4,"es":"Después del desayuno, ¿qué haces?","ko":"아침을 먹은 다음엔 뭐 해요?"},{"s":"M","t":261.3,"es":"Mmm.","ko":"음."},{"s":"S","t":263.2,"es":"¿Trabajas o estudias?","ko":"일해요, 공부해요?"},{"s":"M","t":267.7,"es":"Yo trabajo.","ko":"저는 일해요."},{"s":"S","t":270.7,"es":"Ah, trabajas. Muy bien. Sí, yo también trabajo.","ko":"아, 일하는군요. 좋아요. 네, 저도 일해요."},{"s":"M","t":281.1,"es":"Sí, sí. Yo voy al trabajo.","ko":"네, 네. 저는 일하러 가요."},{"s":"S","t":288.3,"es":"«Voy al trabajo». O puedes decir: «Yo trabajo».","ko":"'일하러 가요.' 아니면 '저는 일해요'라고 해도 돼요."},{"s":"M","t":296.1,"es":"Yo trabajo.","ko":"저는 일해요."},{"s":"S","t":299.1,"es":"¿A qué hora trabajas, Mateo?","ko":"마테오, 몇 시에 일해요?"},{"s":"M","t":302.5,"es":"Yo trabajo a las nueve.","ko":"저는 9시에 일해요."},{"s":"S","t":306.2,"es":"A las nueve. Perfecto.","ko":"9시. 완벽해요."},{"s":"M","t":310.1,"es":"Sí, a las nueve.","ko":"네, 9시에요."}]},{"title":"6. 오후 · 점심 먹고 집에 와요 (Como · Vuelvo a casa)","lines":[{"s":"S","t":313.7,"es":"Ahora, la tarde.","ko":"이제 오후예요."},{"s":"M","t":316.8,"es":"La tarde.","ko":"오후."},{"s":"S","t":318.5,"es":"Por la tarde yo… como.","ko":"오후에 저는… 점심을 먹어요."},{"s":"M","t":322.0,"es":"¿Como?","ko":"como요?"},{"s":"S","t":325.0,"es":"Puedes decir «como» o «almuerzo».","ko":"como(먹어요) 또는 almuerzo(점심을 먹어요)라고 말할 수 있어요."},{"s":"M","t":331.6,"es":"Como. Almuerzo.","ko":"먹어요. 점심을 먹어요."},{"s":"S","t":335.8,"es":"Yo como a las dos.","ko":"저는 2시에 점심을 먹어요."},{"s":"M","t":339.6,"es":"A las dos.","ko":"2시에."},{"s":"S","t":342.8,"es":"¿A qué hora comes tú, Mateo?","ko":"마테오는 몇 시에 점심을 먹어요?"},{"s":"M","t":347.2,"es":"Yo como a la una y media.","ko":"저는 1시 반에 먹어요."},{"s":"S","t":352.6,"es":"A la una y media, un poco antes que yo.","ko":"1시 반, 저보다 조금 일찍이네요."},{"s":"M","t":360.0,"es":"Sí.","ko":"네."},{"s":"S","t":361.7,"es":"Después de comer, yo trabajo más.","ko":"점심 먹은 다음에 저는 일을 더 해요."},{"s":"M","t":367.6,"es":"Trabajas.","ko":"일하는군요."},{"s":"S","t":369.7,"es":"Y por la tarde vuelvo a casa.","ko":"그리고 오후에 집에 돌아와요."},{"s":"M","t":374.8,"es":"Vuelvo a casa.","ko":"집에 돌아와요."},{"s":"S","t":377.3,"es":"Yo vuelvo a casa a las seis.","ko":"저는 6시에 집에 와요."},{"s":"M","t":383.0,"es":"A las seis.","ko":"6시에."},{"s":"S","t":385.8,"es":"¿A qué hora vuelves a casa, Mateo?","ko":"마테오는 몇 시에 집에 와요?"},{"s":"M","t":390.4,"es":"Yo vuelvo a casa a las cinco.","ko":"저는 5시에 집에 와요."},{"s":"S","t":394.3,"es":"A las cinco. Muy bien. Estamos casi al final del día.","ko":"5시. 좋아요. 이제 하루가 거의 끝나 가요."}]},{"title":"7. 저녁 · 밤 (Ceno · Veo la televisión · Descanso)","lines":[{"s":"S","t":403.1,"es":"La noche.","ko":"밤이에요."},{"s":"M","t":405.3,"es":"La noche.","ko":"밤."},{"s":"S","t":407.0,"es":"Por la noche yo ceno.","ko":"밤에 저는 저녁을 먹어요."},{"s":"M","t":411.2,"es":"Ceno.","ko":"저녁을 먹어요."},{"s":"S","t":412.7,"es":"Yo ceno a las ocho.","ko":"저는 8시에 저녁을 먹어요."},{"s":"M","t":417.8,"es":"A las ocho.","ko":"8시에."},{"s":"S","t":420.5,"es":"Después de cenar, a veces veo la televisión.","ko":"저녁을 먹은 다음엔 가끔 텔레비전을 봐요."},{"s":"M","t":427.0,"es":"Veo la televisión.","ko":"텔레비전을 봐요."},{"s":"S","t":429.1,"es":"Otras veces leo un libro.","ko":"어떤 때는 책을 읽어요."},{"s":"M","t":434.7,"es":"Leo un libro.","ko":"책을 읽어요."},{"s":"S","t":439.2,"es":"O escucho música.","ko":"아니면 음악을 들어요."},{"s":"M","t":444.3,"es":"Escucho música.","ko":"음악을 들어요."},{"s":"S","t":447.0,"es":"Y después descanso.","ko":"그리고 쉬어요."},{"s":"M","t":451.1,"es":"Descanso.","ko":"쉬어요."},{"s":"S","t":453.5,"es":"¿Qué haces tú por la noche, Mateo?","ko":"마테오는 밤에 뭐 해요?"},{"s":"M","t":459.4,"es":"Yo ceno.","ko":"저는 저녁을 먹어요."},{"s":"S","t":462.2,"es":"Sí. ¿A qué hora cenas?","ko":"네. 몇 시에 저녁을 먹어요?"},{"s":"M","t":465.4,"es":"Ceno a las siete y media.","ko":"7시 반에 저녁을 먹어요."},{"s":"S","t":469.0,"es":"A las siete y media.","ko":"7시 반."},{"s":"M","t":472.2,"es":"Y después de cenar, yo veo la televisión.","ko":"그리고 저녁을 먹은 다음엔 텔레비전을 봐요."},{"s":"S","t":480.0,"es":"Muy bien. ¿Y escuchas música?","ko":"좋아요. 음악도 들어요?"},{"s":"M","t":485.4,"es":"A veces.","ko":"가끔요."}]},{"title":"8. 잠자리에 들기 (Me acuesto · Duermo 8 horas)","lines":[{"s":"S","t":488.0,"es":"Perfecto. Y el final del día. ¿Qué más? Me acuesto.","ko":"완벽해요. 그리고 하루의 끝. 또 뭐가 있죠? 잠자리에 들어요."},{"s":"M","t":499.2,"es":"Me acuesto.","ko":"잠자리에 들어요."},{"s":"S","t":502.0,"es":"Yo me acuesto a las once.","ko":"저는 11시에 잠자리에 들어요."},{"s":"M","t":507.1,"es":"A las once.","ko":"11시에."},{"s":"S","t":509.8,"es":"Y duermo ocho horas.","ko":"그리고 8시간 자요."},{"s":"M","t":515.5,"es":"Duermo ocho horas.","ko":"8시간 자요."},{"s":"S","t":520.0,"es":"¿A qué hora te acuestas tú, Mateo?","ko":"마테오는 몇 시에 자러 가요?"},{"s":"M","t":525.1,"es":"Yo me acuesto a las diez.","ko":"저는 10시에 잠자리에 들어요."},{"s":"S","t":529.1,"es":"A las diez. Más temprano que yo.","ko":"10시. 저보다 일찍이네요."},{"s":"M","t":534.0,"es":"Sí.","ko":"네."},{"s":"S","t":535.7,"es":"¿Y cuántas horas duermes?","ko":"그럼 몇 시간 자요?"},{"s":"M","t":539.7,"es":"Yo duermo nueve horas.","ko":"저는 9시간 자요."},{"s":"S","t":545.2,"es":"Nueve horas. ¡Qué bien! Descansas mucho.","ko":"9시간. 좋네요! 많이 쉬는군요."}]},{"title":"9. 듣기 ① 카를로스의 하루 (La rutina de Carlos)","lines":[{"s":"S","t":549.4,"es":"Muy bien, Mateo. Ahora, una pequeña historia.","ko":"아주 좋아요, 마테오. 이제 짧은 이야기예요."},{"s":"M","t":557.4,"es":"Una historia.","ko":"이야기."},{"s":"S","t":559.8,"es":"Escucha bien. Es la rutina de Carlos. ¿De acuerdo?","ko":"잘 들어 보세요. 카를로스의 하루 일과예요. 좋죠?"},{"s":"S","t":567.7,"es":"Carlos se levanta a las siete. Se ducha y se viste.","ko":"카를로스는 7시에 일어나요. 샤워하고 옷을 입어요."},{"s":"S","t":579.6,"es":"Desayuna a las ocho. Va al trabajo. Come a la una.","ko":"8시에 아침을 먹어요. 일하러 가요. 1시에 점심을 먹어요."},{"s":"S","t":596.2,"es":"Vuelve a casa a las seis. Cena a las siete y media. Ve la televisión.","ko":"6시에 집에 와요. 7시 반에 저녁을 먹어요. 텔레비전을 봐요."},{"s":"S","t":617.3,"es":"Se acuesta a las diez y duerme ocho horas.","ko":"10시에 잠자리에 들고 8시간 자요."},{"s":"S","t":631.7,"es":"Ahora, unas preguntas.","ko":"이제 질문 몇 개예요."},{"s":"M","t":635.5,"es":"Estoy listo.","ko":"준비됐어요."},{"s":"S","t":638.0,"es":"¿A qué hora se levanta Carlos?","ko":"카를로스는 몇 시에 일어나요?"},{"s":"M","t":642.9,"es":"Se levanta a las siete.","ko":"7시에 일어나요."},{"s":"S","t":646.0,"es":"Correcto. ¿A qué hora desayuna?","ko":"정답. 몇 시에 아침을 먹어요?"},{"s":"M","t":651.7,"es":"Desayuna a las ocho.","ko":"8시에 아침을 먹어요."},{"s":"S","t":655.4,"es":"Exacto. ¿Cuándo vuelve a casa?","ko":"맞아요. 언제 집에 와요?"},{"s":"M","t":659.9,"es":"Vuelve a casa a las seis.","ko":"6시에 집에 와요."},{"s":"S","t":663.9,"es":"Perfecto. ¿A qué hora se acuesta?","ko":"완벽해요. 몇 시에 잠자리에 들어요?"},{"s":"M","t":669.6,"es":"Se acuesta a las diez.","ko":"10시에 잠자리에 들어요."},{"s":"S","t":673.5,"es":"Muy bien. ¿Cuántas horas duerme Carlos?","ko":"좋아요. 카를로스는 몇 시간 자요?"},{"s":"M","t":681.0,"es":"Duerme ocho horas.","ko":"8시간 자요."},{"s":"S","t":684.3,"es":"Genial. Lo has entendido todo.","ko":"멋져요. 다 이해했네요."}]},{"title":"10. 듣기 ② 작은 도전 · 아나의 하루 (Un pequeño reto)","lines":[{"s":"S","t":688.5,"es":"Ahora, un pequeño reto.","ko":"이제 작은 도전이에요."},{"s":"M","t":692.4,"es":"Un reto.","ko":"도전."},{"s":"S","t":694.4,"es":"Escucha la rutina de Ana.","ko":"아나의 하루 일과를 들어 보세요."},{"s":"M","t":698.8,"es":"Escucho.","ko":"듣고 있어요."},{"s":"S","t":700.3,"es":"Ana se levanta a las seis. Se ducha.","ko":"아나는 6시에 일어나요. 샤워해요."},{"s":"S","t":711.6,"es":"Desayuna café y fruta a las siete.","ko":"7시에 커피와 과일로 아침을 먹어요."},{"s":"S","t":721.2,"es":"Estudia español por la mañana.","ko":"오전에 스페인어를 공부해요."},{"s":"S","t":729.3,"es":"Come a la una. Por la tarde lee un libro.","ko":"1시에 점심을 먹어요. 오후에는 책을 읽어요."},{"s":"S","t":742.5,"es":"Cena a las ocho. Se acuesta a las once.","ko":"8시에 저녁을 먹어요. 11시에 잠자리에 들어요."},{"s":"S","t":754.0,"es":"¿A qué hora se levanta Ana?","ko":"아나는 몇 시에 일어나요?"},{"s":"M","t":758.7,"es":"Se levanta a las seis.","ko":"6시에 일어나요."},{"s":"S","t":762.0,"es":"Sí. ¿Qué desayuna?","ko":"네. 아침으로 뭘 먹어요?"},{"s":"M","t":765.8,"es":"Desayuna café y fruta.","ko":"커피와 과일을 먹어요."},{"s":"S","t":770.0,"es":"Correcto. ¿Qué hace por la mañana?","ko":"정답. 오전엔 뭘 해요?"},{"s":"M","t":776.3,"es":"Estudia español.","ko":"스페인어를 공부해요."},{"s":"S","t":779.4,"es":"Exacto. ¿Qué hace por la tarde?","ko":"맞아요. 오후엔 뭘 해요?"},{"s":"M","t":784.3,"es":"Lee un libro.","ko":"책을 읽어요."},{"s":"S","t":787.8,"es":"Muy bien. ¿A qué hora se acuesta?","ko":"좋아요. 몇 시에 잠자리에 들어요?"},{"s":"M","t":792.8,"es":"Se acuesta a las once.","ko":"11시에 잠자리에 들어요."},{"s":"S","t":797.6,"es":"Perfecto. Lo has hecho muy bien, Mateo.","ko":"완벽해요. 아주 잘했어요, 마테오."}]},{"title":"11. 네 차례 · 마테오의 하루 (Te toca a ti)","lines":[{"s":"S","t":802.2,"es":"Ahora te toca a ti, Mateo.","ko":"이제 당신 차례예요, 마테오."},{"s":"M","t":806.7,"es":"¿A mí?","ko":"저요?"},{"s":"S","t":808.2,"es":"Sí. Vamos a hablar de tu rutina. ¿De acuerdo? ¿A qué hora te levantas?","ko":"네. 당신의 하루 일과를 이야기해 봐요. 좋죠? 몇 시에 일어나요?"},{"s":"M","t":818.0,"es":"Me levanto a las ocho.","ko":"8시에 일어나요."},{"s":"S","t":821.6,"es":"Muy bien. ¿Qué haces por la mañana?","ko":"좋아요. 아침엔 뭐 해요?"},{"s":"M","t":827.6,"es":"Me ducho, me lavo los dientes.","ko":"샤워하고, 이를 닦아요."},{"s":"S","t":832.1,"es":"Excelente. ¿Qué desayunas?","ko":"훌륭해요. 아침으로 뭘 먹어요?"},{"s":"M","t":838.2,"es":"Desayuno café y pan.","ko":"커피와 빵을 먹어요."},{"s":"S","t":842.3,"es":"¡Qué rico! ¿Trabajas o estudias?","ko":"맛있겠다! 일해요, 공부해요?"},{"s":"M","t":848.6,"es":"Trabajo.","ko":"일해요."},{"s":"S","t":850.3,"es":"Muy bien. ¿A qué hora comes?","ko":"좋아요. 몇 시에 점심을 먹어요?"},{"s":"M","t":854.6,"es":"Como a la una y media.","ko":"1시 반에 먹어요."},{"s":"S","t":858.4,"es":"¿Entendido? ¿Cuándo vuelves a casa?","ko":"알겠어요. 언제 집에 와요?"},{"s":"M","t":863.3,"es":"Vuelvo a casa a las cinco.","ko":"5시에 집에 와요."},{"s":"S","t":867.0,"es":"Perfecto. ¿Qué haces por la noche?","ko":"완벽해요. 밤엔 뭐 해요?"},{"s":"M","t":872.4,"es":"Ceno. Veo la televisión.","ko":"저녁을 먹어요. 텔레비전을 봐요."},{"s":"S","t":876.2,"es":"Genial. ¿A qué hora te acuestas?","ko":"멋져요. 몇 시에 잠자리에 들어요?"},{"s":"M","t":881.4,"es":"Me acuesto a las diez.","ko":"10시에 잠자리에 들어요."},{"s":"S","t":884.3,"es":"Fantástico. Muy bien, Mateo.","ko":"환상적이에요. 아주 좋아요, 마테오."}]},{"title":"12. 다 이어서 말하기 · 소피아의 하루 (Todo junto)","lines":[{"s":"S","t":889.4,"es":"Ahora, todo junto.","ko":"이제 다 이어서 말해 봐요."},{"s":"M","t":891.0,"es":"Todo junto.","ko":"다 이어서."},{"s":"S","t":893.0,"es":"Sí. Dime tu rutina paso a paso. Empieza.","ko":"네. 하루 일과를 한 단계씩 말해 주세요. 시작하세요."},{"s":"M","t":904.5,"es":"Me levanto a las… Me levanto a las ocho.","ko":"저는 … 시에 일어나요. 8시에 일어나요."},{"s":"S","t":911.5,"es":"Sí.","ko":"네."},{"s":"M","t":913.0,"es":"Después me ducho y luego desayuno café y pan. A las ocho y media.","ko":"그다음에 샤워하고, 그리고 커피와 빵으로 아침을 먹어요. 8시 반에요."},{"s":"S","t":925.6,"es":"Excelente. ¿Qué más?","ko":"훌륭해요. 또요?"},{"s":"M","t":929.0,"es":"Voy al trabajo a las nueve.","ko":"9시에 일하러 가요."},{"s":"S","t":933.4,"es":"Perfecto.","ko":"완벽해요."},{"s":"M","t":935.4,"es":"Como a la una y media.","ko":"1시 반에 점심을 먹어요."},{"s":"S","t":939.1,"es":"Muy bien.","ko":"아주 좋아요."},{"s":"M","t":941.1,"es":"Vuelvo a casa a las cinco.","ko":"5시에 집에 와요."},{"s":"S","t":944.9,"es":"Genial.","ko":"멋져요."},{"s":"M","t":947.8,"es":"Ceno a las siete y media. Sí, veo la televisión.","ko":"7시 반에 저녁을 먹어요. 네, 텔레비전을 봐요."},{"s":"S","t":956.2,"es":"Claro.","ko":"좋아요."},{"s":"M","t":958.4,"es":"Me acuesto a las diez.","ko":"10시에 잠자리에 들어요."},{"s":"S","t":961.4,"es":"¡Bravo, Mateo! Lo has hecho. Ahora escucha mi rutina completa de nuevo.","ko":"브라보, 마테오! 해냈어요. 이제 제 하루 일과 전체를 다시 들어 보세요."},{"s":"M","t":971.2,"es":"Escucho.","ko":"듣고 있어요."},{"s":"S","t":972.6,"es":"Hola, me llamo Sofía. Me levanto a las siete. Me ducho, me lavo los dientes, me visto.","ko":"안녕하세요, 제 이름은 소피아예요. 7시에 일어나요. 샤워하고, 이를 닦고, 옷을 입어요."},{"s":"S","t":991.8,"es":"Desayuno a las ocho, voy al trabajo a las nueve, como a las dos.","ko":"8시에 아침을 먹고, 9시에 일하러 가고, 2시에 점심을 먹어요."},{"s":"S","t":1002.3,"es":"Vuelvo a casa a las seis, ceno a las ocho. Veo la televisión, leo un libro, escucho música.","ko":"6시에 집에 오고, 8시에 저녁을 먹어요. 텔레비전을 보고, 책을 읽고, 음악을 들어요."},{"s":"S","t":1018.2,"es":"Me acuesto a las once. Duermo ocho horas.","ko":"11시에 잠자리에 들어요. 8시간 자요."},{"s":"M","t":1028.2,"es":"Sí, lo entiendo.","ko":"네, 이해했어요."},{"s":"S","t":1031.9,"es":"Ahora, Mateo, habla de tu rutina diaria.","ko":"이제 마테오, 당신의 하루 일과를 말해 보세요."},{"s":"M","t":1038.1,"es":"De acuerdo.","ko":"좋아요."}]}],"vocab":[{"title":"아침 (Por la mañana)","rows":[["me despierto","잠에서 깨요 (눈을 떠요)"],["me levanto","일어나요 (침대에서 나와요)"],["me ducho","샤워해요"],["me lavo los dientes","이를 닦아요"],["me visto","옷을 입어요"],["desayuno","아침을 먹어요"],["el desayuno","아침 식사"],["café y pan","커피와 빵"]]},{"title":"낮 · 저녁 · 밤","rows":[["voy al trabajo","일하러 가요"],["trabajo / estudio","일해요 / 공부해요"],["como / almuerzo","점심을 먹어요"],["vuelvo a casa","집에 돌아와요"],["ceno","저녁을 먹어요"],["veo la televisión","텔레비전을 봐요"],["leo un libro","책을 읽어요"],["escucho música","음악을 들어요"],["descanso","쉬어요"],["me acuesto","잠자리에 들어요"],["duermo ocho horas","8시간 자요"]]},{"title":"시간 말하기","rows":[["¿A qué hora …?","몇 시에 …해요?"],["a la una","1시에"],["a las dos / a las siete","2시에 / 7시에"],["a las ocho y media","8시 반에"],["a la una y media","1시 반에"],["a las siete y cuarto","7시 15분에 +보너스"],["por la mañana","아침에, 오전에"],["por la tarde","오후에"],["por la noche","밤에, 저녁에"],["desde la mañana hasta la noche","아침부터 밤까지"]]},{"title":"순서 · 빈도","rows":[["primero","먼저"],["después","그다음에"],["luego","그리고, 그다음"],["finalmente","마지막으로"],["después de levantarme","일어난 다음에"],["después de comer / cenar","점심 / 저녁을 먹은 다음에"],["después del desayuno","아침 식사 후에"],["a veces / otras veces","가끔 / 어떤 때는"],["más temprano que yo","나보다 일찍"],["un poco antes que yo","나보다 조금 먼저"]]},{"title":"묻고 답하기","rows":[["¿A qué hora te levantas?","몇 시에 일어나요?"],["¿Qué haces por la mañana?","아침에 뭐 해요?"],["¿Qué desayunas?","아침으로 뭘 먹어요?"],["¿A qué hora comes?","몇 시에 점심을 먹어요?"],["¿Cuándo vuelves a casa?","언제 집에 와요?"],["¿A qué hora te acuestas?","몇 시에 잠자리에 들어요?"],["¿Cuántas horas duermes?","몇 시간 자요?"],["la rutina diaria","하루 일과"]]},{"title":"기타 표현","rows":[["¿Estás listo/a?","준비됐어요?"],["Estoy listo/a.","준비됐어요."],["¿Algo más?","또 있어요?"],["Lo haces genial.","정말 잘하고 있어요."],["un desayuno típico","전형적인 아침 식사"],["¡Descansas mucho!","많이 쉬네요!"],["paso a paso","한 단계씩"],["de nuevo","다시"]]}]}